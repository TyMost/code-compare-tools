package com.example.migratediff;

import com.example.migratediff.application.CoverageAppService;
import com.example.migratediff.domain.coverage.CoverageDetail;
import com.example.migratediff.domain.coverage.CoverageSummary;
import com.example.migratediff.domain.diff.DiffBlock;
import com.example.migratediff.domain.diff.DiffFile;
import com.example.migratediff.domain.diff.DiffSummary;
import com.example.migratediff.domain.repo.RepoConfig;
import com.example.migratediff.domain.repo.RepoPath;
import com.example.migratediff.infrastructure.git.GitDiffAdapter;
import com.example.migratediff.infrastructure.git.GitRepoScanner;
import com.example.migratediff.infrastructure.persistence.CoverageRepository;
import org.eclipse.jgit.lib.Repository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.TestMethodOrder;
import org.junit.jupiter.api.MethodOrderer;
import org.junit.jupiter.api.Order;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.test.context.TestPropertySource;
import org.springframework.test.util.ReflectionTestUtils;

import java.io.IOException;
import java.util.*;
import java.util.stream.Collectors;

/**
 * 快速覆盖率计算工具
 * 用于快速计算指定文件在Oracle和Gauss仓库之间的覆盖率
 */
@SpringBootTest
@TestPropertySource(locations = "classpath:application.properties")
@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
public class QuickCoverageCalculatorTest {

    @Autowired
    private CoverageAppService coverageAppService;

    @Autowired
    private GitRepoScanner gitRepoScanner;

    @Autowired
    private GitDiffAdapter gitDiffAdapter;

    @Autowired(required = false)
    private CoverageRepository coverageRepository;

    private RepoConfig oracleConfig;
    private RepoConfig gaussConfig;

    @BeforeEach
    void setUp() {
        // 从application.properties读取配置创建RepoConfig
        oracleConfig = createRepoConfig("o", "D:\\Coding\\code-compare-tools\\examples\\o");
        gaussConfig = createRepoConfig("g", "D:\\Coding\\code-compare-tools\\examples\\g");
    }

    /**
     * 创建仓库配置
     */
    private RepoConfig createRepoConfig(String code, String path) {
        RepoPath repoPath = RepoPath.builder()
                .absolutePath(path)
                .type(code.equals("o") ? com.example.migratediff.domain.repo.RepoType.ORACLE : com.example.migratediff.domain.repo.RepoType.GAUSS)
                .build();
        
        RepoConfig config = RepoConfig.builder()
                .id(code)
                .name(code + " Repository")
                .repoPath(repoPath)
                .deltaType(code.equals("g") ? com.example.migratediff.domain.diff.DeltaType.DELTA_G : com.example.migratediff.domain.diff.DeltaType.DELTA_O)
                .scanStrategy(com.example.migratediff.domain.repo.ScanStrategy.SNAPSHOT)
                .build();
        
        return config;
    }

    /**
     * 计算单个文件的覆盖率
     */
    @Test
    @Order(1)
    public void calculateSingleFileCoverage() throws IOException {
        String filePath = "src/main/java/com/example/service/UserService.java";
        System.out.println("\n=== 单文件覆盖率计算 ===");
        calculateCoverageForFiles(Arrays.asList(filePath));
    }

    /**
     * 计算多个文件的覆盖率
     */
    @Test
    @Order(2)
    public void calculateMultipleFilesCoverage() throws IOException {
        List<String> filePaths = Arrays.asList(
            "src/main/java/com/example/service/UserService.java",
            "src/main/java/com/example/controller/UserController.java",
            "src/main/java/com/example/entity/User.java"
        );
        System.out.println("\n=== 多文件覆盖率计算 ===");
        calculateCoverageForFiles(filePaths);
    }

    /**
     * 计算所有Service文件的覆盖率
     */
    @Test
    @Order(3)
    public void calculateAllServiceFilesCoverage() throws IOException {
        System.out.println("\n=== 所有Service文件覆盖率计算 ===");
        
        // 获取Oracle仓库的所有Java文件
        DiffSummary oracleSummary = getDiffSummary(oracleConfig);
        DiffSummary gaussSummary = getDiffSummary(gaussConfig);

        List<String> serviceFiles = oracleSummary.getDiffFiles().stream()
            .filter(file -> file.getRelativePath() != null && 
                           file.getRelativePath().contains("/service/") &&
                           file.getRelativePath().endsWith(".java"))
            .map(DiffFile::getRelativePath)
            .collect(Collectors.toList());

        System.out.println("找到Service文件数量: " + serviceFiles.size());
        calculateCoverageForFiles(serviceFiles);
    }

    /**
     * 生成完整的覆盖率报告
     */
    @Test
    @Order(4)
    public void generateCoverageReport() throws IOException {
        System.out.println("\n=== 完整覆盖率报告 ===");
        
        DiffSummary oracleSummary = getDiffSummary(oracleConfig);
        DiffSummary gaussSummary = getDiffSummary(gaussConfig);

        CoverageSummary summary = coverageAppService.analyzeCoverage(
            "quick-report-" + System.currentTimeMillis(),
            oracleSummary,
            gaussSummary,
            false // 不持久化，仅生成报告
        );

        printDetailedCoverageReport(summary);
    }

    /**
     * 计算特定文件的覆盖率
     */
    private void calculateCoverageForFiles(List<String> filePaths) throws IOException {
        DiffSummary oracleSummary = getDiffSummary(oracleConfig);
        DiffSummary gaussSummary = getDiffSummary(gaussConfig);

        // 过滤出指定文件
        List<DiffFile> filteredOracleFiles = oracleSummary.getDiffFiles().stream()
            .filter(file -> filePaths.contains(file.getRelativePath()))
            .collect(Collectors.toList());

        List<DiffFile> filteredGaussFiles = gaussSummary.getDiffFiles().stream()
            .filter(file -> filePaths.contains(file.getRelativePath()))
            .collect(Collectors.toList());

        if (filteredOracleFiles.isEmpty()) {
            System.out.println("⚠️  在Oracle仓库中未找到指定文件: " + filePaths);
            return;
        }

        CoverageSummary summary = coverageAppService.analyzeCoverage(
            "quick-calculation-" + System.currentTimeMillis(),
            filteredOracleFiles,
            filteredGaussFiles,
            false
        );

        printSimpleCoverageReport(summary, filePaths);
    }

    /**
     * 获取差异摘要
     */
    private DiffSummary getDiffSummary(RepoConfig config) throws IOException {
        return gitRepoScanner.scan(config);
    }

    /**
     * 打印简单的覆盖率报告
     */
    private void printSimpleCoverageReport(CoverageSummary summary, List<String> targetFiles) {
        System.out.println("📊 覆盖率统计:");
        System.out.println("   总体覆盖率: " + String.format("%.2f%%", summary.getOverallCoverage() * 100));
        System.out.println("   总行数: " + summary.getTotalLines());
        System.out.println("   匹配行数: " + summary.getTotalMatchedLines());
        System.out.println("   文件数量: " + summary.getDetails().size());

        System.out.println("\n📋 文件详情:");
        for (CoverageDetail detail : summary.getDetails()) {
            if (targetFiles.contains(detail.getFilePath())) {
                System.out.println("   📄 " + detail.getFilePath());
                System.out.println("      覆盖率: " + String.format("%.2f%%", detail.getCoverage() * 100));
                System.out.println("      总行数: " + detail.getTotalLines());
                System.out.println("      匹配行数: " + detail.getMatchedLines());
                
                if (!detail.getUnmatchedBlocks().isEmpty()) {
                    System.out.println("      未覆盖块: " + detail.getUnmatchedBlocks().size());
                    for (DiffBlock unmatchedBlock : detail.getUnmatchedBlocks()) {
                        System.out.println("        - 行" + unmatchedBlock.getStartLineFrom() + "-" + 
                                         unmatchedBlock.getEndLineFrom() + ": " + unmatchedBlock.getType());
                    }
                }
                System.out.println();
            }
        }
    }

    /**
     * 打印详细的覆盖率报告
     */
    private void printDetailedCoverageReport(CoverageSummary summary) {
        System.out.println("🎯 完整覆盖率报告");
        System.out.println("============================================================");
        
        // 总体统计
        System.out.println("📊 总体统计:");
        System.out.println("   总体覆盖率: " + String.format("%.2f%%", summary.getOverallCoverage() * 100));
        System.out.println("   总行数: " + summary.getTotalLines());
        System.out.println("   匹配行数: " + summary.getTotalMatchedLines());
        System.out.println("   文件数量: " + summary.getDetails().size());

        // 覆盖率分布统计
        Map<String, Long> coverageDistribution = new LinkedHashMap<>();
        coverageDistribution.put("81-100% (高)", 0L);
        coverageDistribution.put("61-80% (中高)", 0L);
        coverageDistribution.put("41-60% (中等)", 0L);
        coverageDistribution.put("21-40% (中低)", 0L);
        coverageDistribution.put("0-20% (低)", 0L);

        for (CoverageDetail detail : summary.getDetails()) {
            double coverage = detail.getCoverage() * 100;
            if (coverage >= 81) {
                coverageDistribution.put("81-100% (高)", coverageDistribution.get("81-100% (高)") + 1);
            } else if (coverage >= 61) {
                coverageDistribution.put("61-80% (中高)", coverageDistribution.get("61-80% (中高)") + 1);
            } else if (coverage >= 41) {
                coverageDistribution.put("41-60% (中等)", coverageDistribution.get("41-60% (中等)") + 1);
            } else if (coverage >= 21) {
                coverageDistribution.put("21-40% (中低)", coverageDistribution.get("21-40% (中低)") + 1);
            } else {
                coverageDistribution.put("0-20% (低)", coverageDistribution.get("0-20% (低)") + 1);
            }
        }

        System.out.println("\n📈 覆盖率分布:");
        coverageDistribution.forEach((range, count) -> {
            System.out.println("   " + range + ": " + count + " 个文件");
        });

        // 低覆盖率文件列表
        System.out.println("\n⚠️  低覆盖率文件 (覆盖率 < 50%):");
        List<CoverageDetail> lowCoverageFiles = summary.getDetails().stream()
            .filter(detail -> detail.getCoverage() < 0.5)
            .sorted(Comparator.comparing(CoverageDetail::getCoverage))
            .collect(Collectors.toList());

        if (lowCoverageFiles.isEmpty()) {
            System.out.println("   ✅ 没有低覆盖率文件");
        } else {
            for (CoverageDetail detail : lowCoverageFiles) {
                System.out.println("   📄 " + detail.getFilePath() + 
                                 " - " + String.format("%.2f%%", detail.getCoverage() * 100));
                System.out.println("      未覆盖块: " + detail.getUnmatchedBlocks().size());
            }
        }

        // 高覆盖率文件列表
        System.out.println("\n✅ 高覆盖率文件 (覆盖率 >= 80%):");
        List<CoverageDetail> highCoverageFiles = summary.getDetails().stream()
            .filter(detail -> detail.getCoverage() >= 0.8)
            .sorted(Comparator.comparing(CoverageDetail::getCoverage).reversed())
            .collect(Collectors.toList());

        for (CoverageDetail detail : highCoverageFiles) {
            System.out.println("   📄 " + detail.getFilePath() + 
                             " - " + String.format("%.2f%%", detail.getCoverage() * 100));
        }

        System.out.println("\n============================================================");
    }

    /**
     * 自定义文件覆盖率计算 - 可以通过命令行参数指定文件
     */
    public static void main(String[] args) throws IOException {
        // 这个方法可以在IDE中直接运行，传入文件路径参数
        if (args.length == 0) {
            System.out.println("使用方法: QuickCoverageCalculatorTest <file1> [file2] [file3] ...");
            System.out.println("示例: QuickCoverageCalculatorTest src/main/java/com/example/service/UserService.java");
            return;
        }

        // 注意：这里需要Spring上下文，实际使用时需要通过Spring Boot Test运行
        System.out.println("请使用以下Maven命令运行:");
        System.out.println("mvn test -Dtest=QuickCoverageCalculatorTest#calculateSingleFileCoverage");
    }
}
